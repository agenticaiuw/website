{
	"name": "agenticaiuw-hub",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"types": "wrangler types",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:migrate:local": "wrangler d1 migrations apply agenticaiuw-hub --local",
		"db:migrate": "wrangler d1 migrations apply agenticaiuw-hub --remote",
		"test": "node --experimental-strip-types --test test/*.test.ts"
	},
	"dependencies": {
		"uqr": "0.1.3",
		"worker-mailer": "1.2.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "24.19.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"wrangler": "4.149.0"
	}
}
