{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agenticaiuw-hub",
	// The SvelteKit app plus the hourly reminder run. `npm run build` first.
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Every hub email goes out through Cloudflare Email Sending, from MAIL_FROM. agenticaiuw.com has to be
	// onboarded under Email Service → Email Sending (it adds records on cf-bounce.agenticaiuw.com).
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["team@agenticaiuw.com"] }],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agenticaiuw-hub",
			"database_id": "0d0c3273-d265-4b03-950b-c3a24f17034a",
			"migrations_dir": "migrations"
		}
	],
	// The Files page's files (and the constitution). Their names and places are in D1's club_files.
	// MAIL: the Inbox's emails and attachments, kept apart from the club's files.
	"r2_buckets": [
		{ "binding": "FILES", "bucket_name": "agenticaiuw-hub-files" },
		{ "binding": "MAIL", "bucket_name": "agenticaiuw-hub-mail" }
	],
	// Every hour. The code checks the hour in club time: daily reminders at 9 AM, meeting reminders
	// at 9 AM and 6 PM, urgent tasks every run.
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"APP_URL": "https://hub.agenticaiuw.com",
		"MAIL_FROM": "team@agenticaiuw.com",
		"MAIL_FROM_NAME": "Agentic AI UW",
		// Anyone listed here can always sign in and is an exec. Add the rest from the People page.
		"ADMIN_EMAILS": "eliu59@wisc.edu,team@agenticaiuw.com",
		"TIMEZONE": "America/Chicago"
	},
	"routes": [{ "pattern": "hub.agenticaiuw.com", "custom_domain": true }],
	"observability": { "enabled": true }
	// Secrets (wrangler secret put): APP_SECRET, BADGER_TOKEN (shared with the Discord bot), GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (the sign-in client that adds website signups to the Google Group).
}
